# ============================================================
# Шаблон продакшн-конфига. Скопируй в .env и заполни.
# .env НИКОГДА не коммитится в git (см .gitignore).
# ============================================================

# --- Docker Registry ---
# Владелец образов в ghcr.io — обычно совпадает с GitHub username/org
GHCR_OWNER=medkvadrat

# --- Medialog MSSQL ---
DB_SERVER=192.168.2.229
DB_PORT=1433
DB_NAME=Medialog
DB_USER=dmartynov
# ВАЖНО: старый пароль утёк в переписку, сменить обязательно
DB_PASSWORD=CHANGE_ME

# --- API Gateway ---
# Сгенерировать командой: openssl rand -hex 32
# Этот же токен автоматически используется ботом (GATEWAY_TOKEN)
API_TOKEN=CHANGE_ME
# ID модели консультации по умолчанию; 306 = наш текущий
DEFAULT_MODELS_ID=306

# --- MAX Bot ---
# Токен получить у @MasterBot или в https://business.max.ru
MAX_BOT_TOKEN=CHANGE_ME
