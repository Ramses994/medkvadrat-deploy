# ============================================================
# Шаблон продакшн-конфига. Скопируй в .env и заполни.
# .env НИКОГДА не коммитится в git (см .gitignore).
# ============================================================

# --- Docker Registry ---
# Владелец образов в ghcr.io — обычно совпадает с GitHub username/org
GHCR_OWNER=medkvadrat

# --- Medialog MSSQL ---
DB_SERVER=192.168.2.229
DB_PORT=1433
DB_NAME=Medialog
# Служебная учётная запись только на чтение, см. docs/lk/01 §7.2 и docs/lk/05_SQL_SERVICE_LOGINS.sql
DB_USER=svc_patient_api_ro
# ВАЖНО: старый пароль утёк в переписку, сменить обязательно
DB_PASSWORD=CHANGE_ME
# Логин на запись появится после R4 — docs/lk/05, блок 5
DB_RW_USER=
DB_RW_PASSWORD=
# Имя приложения в сессии MSSQL (app name=...)
DB_APP_NAME=medkvadrat-patient-api

# --- API Gateway ---
# Сгенерировать командой: openssl rand -hex 32
# Этот же токен автоматически используется ботом (GATEWAY_TOKEN)
API_TOKEN=CHANGE_ME
# ID модели консультации по умолчанию; 306 = наш текущий
DEFAULT_MODELS_ID=306
# Минимум часов до приёма, когда ещё можно отменить запись (API /api/me)
CANCEL_MIN_HOURS_BEFORE=24

# LK-0: запись в Medialog только по белым спискам (по умолчанию выключено)
MEDIALOG_WRITE_ENABLED=false
MEDIALOG_WRITE_ALLOW_PATIENTS=
MEDIALOG_WRITE_ALLOW_PL_SUBJ=

# Опрос MOTCONSU (лог изменений) — по умолчанию выключен
MOTCONSU_POLL_ENABLED=false
# PL_EXAM_ID листа ожидания (плюс NAME LIKE N'%ожидан%'). По умолчанию 3118.
WAITLIST_EXAM_IDS=3118

# CORS для будущего web-ЛК: CSV origins; пусто = заголовок не ставится
CORS_ALLOWED_ORIGINS=

# Step 2+ (patient JWT, OTP, SQLite). Для стенда с мобильным ЛК: pilot + секреты ниже.
# dev — без реального OTP, для отладки не нужны JWT/OTP.
AUTH_MODE=dev
AUTH_PILOT_WHITELIST=
# Обязательны при AUTH_MODE=pilot|prod
JWT_SECRET=CHANGE_ME
OTP_HMAC_SECRET=CHANGE_ME
# Staff dashboard. Пустые password/secret — страница /dashboard отвечает 503.
DASHBOARD_PASSWORD=
DASHBOARD_SECRET=
DASHBOARD_SESSION_TTL=12h
DASHBOARD_COOKIE_SECURE=false
DASHBOARD_ALLOWED_CIDRS=192.168.0.0/16,127.0.0.1/32
# Почта для OTP (опционально, пока пусто — код только в dev-логе / заглушка)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=МедКвадрат
SMTP_TLS=starttls

# Путь к SQLite внутри контейнера задан в docker-compose (GATEWAY_DB_PATH=/app/data/gateway.db).
# На хосте данные: volume medkvadrat-gateway-data

# --- MAX Bot ---
# Токен получить у @MasterBot или в https://business.max.ru
MAX_BOT_TOKEN=CHANGE_ME
# Пусто = привязка в боте запрещена всем; пилот: 1,1587578
BOT_LINK_ALLOWLIST_PATIENTS=
# Пилот: 1,1587578. Пустой BOT_LINK или REMINDER список — напоминания и «Вы записаны» никому.
REMINDER_ALLOWLIST_PATIENTS=
# Сообщение сразу после записи. Включает только владелец.
BOOKING_NOTICE_ENABLED=false
